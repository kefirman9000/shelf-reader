<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+: keep screens and pop-ups clear of the status and navigation bars, as before
         (the app lays out its own bars and doesn't draw under the system ones). -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:dialogTheme">@style/AppDialog</item>
        <item name="android:alertDialogTheme">@style/AppAlertDialog</item>
    </style>
    <style name="AppDialog" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="AppAlertDialog" parent="@android:style/ThemeOverlay.Material.Dialog.Alert">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
